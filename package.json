{
  "name": "browser-parser",
  "description": "Capture a typed context report from the current supported browser tab.",
  "version": "0.1.0",
  "type": "module",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dddominikk/browser-parser.git"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "config": {
    "deployments": {
      "bundle": {
        "gist": "",
        "filename": "esnext.bundle.mjs"
      }
    }
  },
  "devDependencies": {
    "@opengsd/gsd-core": "^1.6.1",
    "@types/node": "^26.1.0",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=25"
  },
  "scripts": {
    "source:import": "node --input-type=module --eval \"await import('./src/index.ts')\"",
    "test": "node --test tests/*.test.ts",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "build:mjs-bundle": "tsdown --config tsdown.config.ts && node scripts/validate-mjs-bundle.ts",
    "build:public-ts-bookmarklet": "node scripts/build-public-bookmarklet.ts",
    "build:private-gist-mjs-bundle-bookmarklet": "node scripts/build-private-gist-mjs-bundle-bookmarklet.ts",
    "deploy:mjs-bundle-gist": "node scripts/deploy-mjs-bundle-gist.ts",
    "validate": "npm run source:import && npm run test && npm run typecheck"
  }
}
